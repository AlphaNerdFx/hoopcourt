# Hoopcourt configuration. Copy to .env and edit; .env is gitignored.
# Every value below is optional and shown at its default.

# ---------------------------------------------------------------- index
# Path to the compiled SQLite index built by scripts/build_index.py.
NBA_LEGAL_DB=nba_legal.db

# ---------------------------------------------------------------- generation
# local -> Ollama first, then llama-cpp. cloud -> Anthropic, bring your own key.
# Retrieval works with no backend at all; /query then returns cited sources
# with answer: null, which is a supported state.
BACKEND_MODE=local

# Ollama. Mistral 7B is Apache-2.0, which keeps the stack permissively licensed.
NBA_OLLAMA_MODEL=mistral:7b
NBA_OLLAMA_URL=http://127.0.0.1:11434

# llama-cpp fallback: path to a local GGUF file. Unset means download by repo id.
# NBA_GGUF_PATH=

# Cloud backend, only read when BACKEND_MODE=cloud. Never required.
NBA_CLOUD_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- gating
# auto     conservative character heuristic, no heavy import (default)
# local    exact counts via the local model tokenizer, imports transformers
# cloud    exact counts via the Anthropic API
# `auto` exists because importing transformers costs ~70s on a cold filesystem,
# paid at application startup, for a gate whose fallback already over-counts.
NBA_TOKEN_COUNTER=auto

# ---------------------------------------------------------------- time
# Overrides the season an unqualified question resolves to. Seasons roll over
# in October. Set this to make behaviour reproducible in tests.
# NBA_CURRENT_SEASON=2025
